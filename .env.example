# Keep mock for local UI/E2E. Use supabase only after applying every SQL file
# in the documented order and setting both public values below.
NEXT_PUBLIC_DATA_SOURCE=mock

# Supabase browser-safe project values. Never commit secret/service-role keys.
NEXT_PUBLIC_SUPABASE_URL=
# Preferred for current Supabase projects.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Optional legacy fallback for projects that still expose an anon key.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
